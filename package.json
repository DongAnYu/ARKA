{
  "name": "arka",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "version:set": "node scripts/set-version.mjs",
    "eval:default": "cargo run --manifest-path eval/Cargo.toml --bin aqg_eval -- --note docs/evaluation_notes/Photosynthesis.md --output-dir eval/output",
    "eval:graph-stage-a": "cargo run --manifest-path eval/Cargo.toml --bin graph_stage_a_eval -- --note docs/evaluation_notes/Photosynthesis.md --output-dir eval/output",
    "eval:graph-e2e": "cargo run --manifest-path eval/Cargo.toml --bin graph_e2e_eval -- --note docs/evaluation_notes/Photosynthesis.md --output-dir eval/output",
    "eval:entity-resolution": "cargo run --manifest-path eval/Cargo.toml --bin entity_resolution_eval -- --fixture eval/fixtures/entity_resolution/photosynthesis.json --output-dir eval/output",
    "eval:entity-resolution:hard": "cargo run --manifest-path eval/Cargo.toml --bin entity_resolution_eval -- --fixture eval/fixtures/entity_resolution/photosynthesis-hard.json --output-dir eval/output",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
